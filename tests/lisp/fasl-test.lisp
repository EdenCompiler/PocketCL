(in-package :pocket.test)

(defvar *fasl-roundtrip-value* nil)

(defun fasl-test-bytes-equal (left right)
  (if (/= (pocket.sys::%bytes-length left)
          (pocket.sys::%bytes-length right))
      nil
      (let ((index 0) (same t)
            (length (pocket.sys::%bytes-length left)))
        (tagbody compare
          (if (or (= index length) (not same)) (go done) nil)
          (if (/= (pocket.sys::%u8-ref left index)
                  (pocket.sys::%u8-ref right index))
              (setq same nil) nil)
          (setq index (1+ index))
          (go compare)
         done)
        same)))

(deftest fasl-writer-loader-roundtrip
  (let* ((uninterned (make-symbol "hidden-λ"))
         (cycle (cons nil nil))
         (wide (pocket.sys::%make-string 4 (code-char 32)))
         (minimum (ash -1 (1- (pocket.sys::%fixnum-bits))))
         (maximum (- (1+ minimum)))
         (vector (vector nil uninterned uninterned wide minimum maximum 1.5))
         (literal (list cycle vector)))
    (rplaca cycle vector)
    (rplacd cycle cycle)
    (pocket.sys::%set-schar wide 0 (code-char 955))
    (pocket.sys::%set-schar wide 1 (code-char 0))
    (pocket.sys::%set-schar wide 2 (code-char 128578))
    (pocket.sys::%set-schar wide 3 (code-char 120))
    (pocket.sys::%set-svref vector 0 cycle)
    (let* ((form (list 'setq '*fasl-roundtrip-value* (list 'quote literal)))
           (proto (pocket-compiler::compile-form form))
           (image (pocket-compiler::write-fasl (list proto) 0))
           (loaded (pocket.sys::%load-fasl image)))
      ;; Perturb subsequent allocation addresses before serializing again.
      (let ((index 0))
        (tagbody allocate
          (if (= index 20) (go allocated) nil)
          (pocket.sys::%make-string 8 (code-char 32))
          (setq index (1+ index))
          (go allocate)
         allocated))
      (is (fasl-test-bytes-equal
           image (pocket-compiler::write-fasl (list proto) 0)))
      (funcall loaded)
      (let* ((result *fasl-roundtrip-value*)
             (roundtrip-cycle (car result))
             (roundtrip-vector (car (cdr result)))
             (roundtrip-string (svref roundtrip-vector 3)))
        (is (eq (car roundtrip-cycle) roundtrip-vector))
        (is (eq (cdr roundtrip-cycle) roundtrip-cycle))
        (is (eq (svref roundtrip-vector 0) roundtrip-cycle))
        (is (eq (svref roundtrip-vector 1) (svref roundtrip-vector 2)))
        (is (null (symbol-package (svref roundtrip-vector 1))))
        (is (= (char-code (schar roundtrip-string 0)) 955))
        (is (= (char-code (schar roundtrip-string 1)) 0))
        (is (= (char-code (schar roundtrip-string 2)) 128578))
        (is (= (svref roundtrip-vector 4) minimum))
        (is (= (svref roundtrip-vector 5) maximum))
        (is (= (svref roundtrip-vector 6) 1.5))))))

(finish)
