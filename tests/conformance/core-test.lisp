(deftest blocks-tags-and-exits
  (is (= (block done (+ 1 (return-from done 9))) 9))
  (is (= (block nil (return 4) 5) 4))
  (is (null (block done (return-from done))))
  (is (= (block done (funcall (lambda () (return-from done 12))) 1) 12))
  (is (= (block a (block b (return-from a 17)) 0) 17))
  (is (= (flet ((local-exit () (return-from local-exit 5))) (local-exit)) 5))
  (is (= (labels ((local-exit () (return-from local-exit 6))) (local-exit)) 6))
  (let ((n 0))
    (tagbody start (setq n (1+ n)) (if (< n 8) (go start)))
    (is (= n 8)))
  (let ((n 0))
    (tagbody 1 (setq n 3) (go 2) (setq n 9) 2 (setq n (1+ n)))
    (is (= n 4)))
  (let ((n 0))
    (tagbody out (funcall (lambda () (setq n (1+ n)) (if (< n 3) (go out)))))
    (is (= n 3)))
  ;; A closure captures the lexical tag owner even when a newer active
  ;; TAGBODY uses the same tag name.
  (let ((continuation nil) (ready nil) (n 0))
    (is (= (catch 'done
             (tagbody again
               (setq continuation (lambda () (go again)))
               (setq n (1+ n))
               (tagbody again
                 (unless ready (setq ready t) (funcall continuation)))
               (throw 'done n))) 2)))
  (is (null (tagbody)))
  (is (= (catch 'done (throw 'done 19)) 19))
  (is (= (catch 'a (catch 'b (throw 'a 23))) 23))
  (is (null (catch 'a (throw 'a nil))))
  (is (= (catch 17 (throw 17 21)) 21)))

(defvar *special-test* 1)
(deftest special-binding-and-unwind
  (is (= *special-test* 1))
  (is (= (let ((*special-test* 4)) *special-test*) 4))
  (is (= *special-test* 1))
  (let ((*special-test* 8))
    (is (= (funcall (lambda () *special-test*)) 8)))
  (is (= *special-test* 1))
  ;; SPECIAL on a binding hides an outer lexical binding of the same name.
  (is (= (let ((local-special 1))
           (let ((local-special 2))
             (declare (special local-special))
             local-special)) 2))
  ;; Parameters obey special proclamations, including calls made by the body.
  (flet ((read-special () *special-test*))
    (is (= (funcall (lambda (*special-test*) (read-special)) 8) 8)))
  (is (= *special-test* 1))
  (set 'declared-special-test 19)
  (let ((declared-special-test 3))
    (declare (ignorable declared-special-test))
    (is (= (locally (declare (special declared-special-test))
             declared-special-test) 19))
    (is (= (let () (declare (special declared-special-test))
             declared-special-test) 19))
    (is (= (funcall (lambda () (declare (special declared-special-test))
                      declared-special-test)) 19)))
  (catch 'done (let ((*special-test* 9)) (throw 'done *special-test*)))
  (is (= *special-test* 1))
  (let ((trace nil))
    (is (= (unwind-protect 4 (setq trace (cons 1 trace))) 4))
    (is-equal '(1) trace)
    (catch 'done
      (unwind-protect
          (unwind-protect (throw 'done 7) (setq trace (cons 2 trace)))
        (setq trace (cons 3 trace))))
    (is-equal '(3 2 1) trace))
  (is (= (catch 'done (unwind-protect (throw 'done 1) (throw 'done 2))) 2))
  (is (= (let ((local-special 4))
           (declare (special local-special))
           (let ((local-special 7)) local-special)) 7)))

(deftest multiple-values
