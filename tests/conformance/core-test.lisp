(deftest evaluation-order
  (let ((trace nil))
    (list (setq trace (cons 1 trace)) (setq trace (cons 2 trace))
          (setq trace (cons 3 trace)))
    (is-equal '(3 2 1) trace))
  (let ((x 5))
    (is (= (let ((x 1) (y x)) (+ x y)) 6))
    (is (= (let* ((x 1) (y x)) (+ x y)) 2)))
  (is (= (let* ((x 1) (get (lambda () x)) (x 2)) (funcall get)) 1))
  (let ((x 0))
    (is (= (setq x 1 x (+ x 2)) 3))
    (is (= x 3)))
  (is (null (setq)))
  (is (= (let ((x 4)) (let ((x 5)) x)) 5))
  ;; A final form inside PROGN/LET is only a tail call when that enclosing
  ;; form is itself in tail position. The side effect must finish here.
  (let ((marked 0))
    (flet ((mark () (setq marked (1+ marked))))
      (progn (mark))
      (is (= marked 1))
      (let () (mark))
      (is (= marked 2))
      (locally (mark))
      (is (= marked 3)))))

