(in-package :pocket-compiler)

;;; PFAS is a wire format, never a dump of the arena. All references are
;;; zero-based IDs and all integers are little endian. A source-ordered work
;;; queue assigns IDs before writing; this also handles shared/cyclic quoted
;;; data without recursive traversal of a potentially long list.
;;;
;;; Registry: #(object-table objects symbol-table symbols proto-table protos).
(defun fasl-registry ()
  (vector (make-eq-table) (make-buffer) (make-eq-table) (make-buffer)
          (make-eq-table) (make-buffer)))
(defun fasl-register (registry table-index buffer-index object)
  (multiple-value-bind (id found) (eq-get (svref registry table-index) object)
    (if found id
        (let ((next (buffer-push (svref registry buffer-index) object)))
          (eq-put (svref registry table-index) object next)
          next))))
(defun fasl-object (registry object) (fasl-register registry 0 1 object))
(defun fasl-id (registry table-index object)
  (multiple-value-bind (id found) (eq-get (svref registry table-index) object)
    (if found id (pocket.sys::%error "PFAS writer: missing graph reference"))))
(defun fasl-scan (registry)
  (let ((objects (svref registry 1)) (index 0))
    (tagbody next
      (if (= index (buffer-length objects)) (go done) nil)
      (let* ((object (buffer-ref objects index))
             (kind (pocket.sys::%object-kind object)))
        (cond
          ((= kind 1)
           (fasl-object registry (car object))
           (fasl-object registry (cdr object)))
          ((= kind 2)
           (let ((slot 0))
             (tagbody element
               (if (= slot (length object)) (go elements-done) nil)
               (fasl-object registry (svref object slot))
               (setq slot (1+ slot))
               (go element)
              elements-done)))
          ((= kind 5) (fasl-register registry 2 3 object))
          ((= kind 9)
           (fasl-register registry 4 5 object)
           (fasl-object registry (pocket.sys::%proto-ref object 0))
           (fasl-object registry (pocket.sys::%proto-ref object 7))
           (fasl-object registry (pocket.sys::%proto-ref object 8)))
          ((or (= kind -1) (= kind -2) (= kind 3) (= kind 4) (= kind 7)) nil)
          (t (pocket.sys::%error "PFAS writer: unsupported literal object"))))
      (setq index (1+ index))
      (go next)
     done)
    registry))

;;; A growing byte vector avoids one cons or pointer-sized slot per output
;;; byte. The final copy trims spare capacity; no arena addresses are emitted.
(defun fasl-output () (vector 0 (pocket.sys::%make-bytes 1024)))
(defun fasl-byte (output byte)
  (let* ((count (svref output 0)) (bytes (svref output 1)))
    (if (= count (pocket.sys::%bytes-length bytes))
        (let ((larger (pocket.sys::%make-bytes (* 2 count))) (index 0))
          (tagbody copy
            (if (= index count) (go copied) nil)
            (pocket.sys::%u8-set larger index (pocket.sys::%u8-ref bytes index))
            (setq index (1+ index))
            (go copy)
           copied)
          (vset output 1 larger)
          (setq bytes larger)) nil)
    (pocket.sys::%u8-set bytes count byte)
    (vset output 0 (1+ count))
    byte))
(defun fasl-integer (output number width)
  (let ((index 0))
    (tagbody next
      (if (= index width) (go done) nil)
      (let* ((remainder (rem number 256))
             (byte (if (< remainder 0) (+ remainder 256) remainder)))
        (fasl-byte output byte)
        ;; Subtracting the nonnegative low byte implements arithmetic shift
        ;; without signed C shifts or an unrepresentable positive 2^64.
        (setq number (truncate (- number byte) 256)))
      (setq index (1+ index))
      (go next)
     done)))
(defun fasl-u32 (output number) (fasl-integer output number 4))

(defun fasl-target-fixnum-p (number bits)
  ;; Wider targets accept every host fixnum. For a narrower target, form its
  ;; negative bound first: the positive magnitude of a target's minimum may
  ;; itself be unrepresentable. Subtraction derives MAX without that value.
  (if (>= bits (pocket.sys::%fixnum-bits))
      (integerp number)
      (let* ((minimum (ash -1 (1- bits))) (maximum (- -1 minimum)))
        (and (integerp number) (<= minimum number) (<= number maximum)))))

(defun fasl-check-target-fixnum (number)
  (if (fasl-target-fixnum-p number (pocket.sys::%fixnum-bits)) number
      (pocket.sys::%error "integer constant exceeds target fixnum range")))
(defun fasl-patch-u32 (output offset number)
  (let ((index 0) (bytes (svref output 1)))
    (tagbody next
      (if (= index 4) (go done) nil)
      (let* ((remainder (rem number 256))
             (byte (if (< remainder 0) (+ remainder 256) remainder)))
        (pocket.sys::%u8-set bytes (+ offset index) byte)
        (setq number (truncate (- number byte) 256)))
      (setq index (1+ index))
      (go next)
     done)))
(defun fasl-copy-bytes (output bytes)
  (let ((index 0))
    (tagbody next
      (if (= index (pocket.sys::%bytes-length bytes)) (go done) nil)
      (fasl-byte output (pocket.sys::%u8-ref bytes index))
      (setq index (1+ index))
      (go next)
     done)))
(defun fasl-finish (output)
  (let* ((count (svref output 0)) (bytes (svref output 1))
         (result (pocket.sys::%make-bytes count)) (index 0))
    (tagbody copy
      (if (= index count) (go done) nil)
      (pocket.sys::%u8-set result index (pocket.sys::%u8-ref bytes index))
      (setq index (1+ index))
      (go copy)
     done)
    result))

(defun fasl-utf8-size (string)
  (let ((index 0) (count 0))
    (tagbody next
      (if (= index (length string)) (go done) nil)
      (let ((code (char-code (schar string index))))
        (setq count (+ count (cond ((< code 128) 1) ((< code 2048) 2)
                                  ((< code 65536) 3) (t 4)))))
      (setq index (1+ index))
      (go next)
     done)
    count))
(defun fasl-utf8 (output string)
  (let ((index 0))
    (tagbody next
      (if (= index (length string)) (go done) nil)
      (let ((code (char-code (schar string index))))
        (cond ((< code 128) (fasl-byte output code))
              ((< code 2048)
               (fasl-byte output (+ 192 (truncate code 64)))
               (fasl-byte output (+ 128 (rem code 64))))
              ((< code 65536)
               (fasl-byte output (+ 224 (truncate code 4096)))
               (fasl-byte output (+ 128 (rem (truncate code 64) 64)))
               (fasl-byte output (+ 128 (rem code 64))))
              (t
               (fasl-byte output (+ 240 (truncate code 262144)))
               (fasl-byte output (+ 128 (rem (truncate code 4096) 64)))
               (fasl-byte output (+ 128 (rem (truncate code 64) 64)))
               (fasl-byte output (+ 128 (rem code 64))))))
      (setq index (1+ index))
      (go next)
     done)))
(defun fasl-string (output string)
  (fasl-u32 output (fasl-utf8-size string))
  (fasl-utf8 output string))
(defun fasl-name (output string)
  ;; Kernel package names currently use bounded C strings. Reject names the
  ;; loader cannot represent rather than emit an image it would truncate.
  (let ((index 0))
    (tagbody next
      (if (= index (length string)) (go done) nil)
      (if (= (char-code (schar string index)) 0)
          (pocket.sys::%error "PFAS writer: NUL in a symbol or package name") nil)
      (setq index (1+ index))
      (go next)
     done))
  (fasl-string output string))
(defun fasl-section (output id count)
  (fasl-u32 output id)
  (let ((offset (svref output 0)))
    (fasl-u32 output 0)
    (fasl-u32 output count)
    offset))
(defun fasl-end-section (output offset)
  (fasl-patch-u32 output offset (- (svref output 0) (+ offset 4))))

(defun fasl-write-symbols (output registry)
  (let* ((symbols (svref registry 3))
         (offset (fasl-section output 1 (buffer-length symbols))) (index 0))
    (tagbody next
      (if (= index (buffer-length symbols)) (go done) nil)
      (let* ((symbol (buffer-ref symbols index)) (home (symbol-package symbol)))
        (if home (fasl-name output (package-name home))
            (progn (fasl-byte output 255) (fasl-byte output 255)
                   (fasl-byte output 255) (fasl-byte output 255)))
        (fasl-name output (symbol-name symbol)))
      (setq index (1+ index))
      (go next)
     done)
    (fasl-end-section output offset)))
(defun fasl-write-object (output registry object)
  (let ((kind (pocket.sys::%object-kind object)))
    (cond
      ((= kind -1)
       (fasl-check-target-fixnum object)
       (fasl-byte output 1) (fasl-u32 output 8) (fasl-integer output object 8))
      ((= kind -2)
       (fasl-byte output 2) (fasl-u32 output 4) (fasl-u32 output (char-code object)))
      ((= kind 7)
       (fasl-byte output 3) (fasl-u32 output 8)
       (fasl-copy-bytes output (pocket.sys::%flonum-bytes object)))
      ((= kind 3)
       (fasl-byte output 4) (fasl-u32 output (fasl-utf8-size object))
       (fasl-utf8 output object))
      ((= kind 5)
       (fasl-byte output 5) (fasl-u32 output 4)
       (fasl-u32 output (fasl-id registry 2 object)))
      ((= kind 1)
       (fasl-byte output 6) (fasl-u32 output 8)
       (fasl-u32 output (fasl-id registry 0 (car object)))
       (fasl-u32 output (fasl-id registry 0 (cdr object))))
      ((= kind 2)
       (fasl-byte output 7) (fasl-u32 output (+ 4 (* 4 (length object))))
       (fasl-u32 output (length object))
       (let ((index 0))
         (tagbody next
           (if (= index (length object)) (go done) nil)
           (fasl-u32 output (fasl-id registry 0 (svref object index)))
           (setq index (1+ index))
           (go next)
          done)))
      ((= kind 4)
       (fasl-byte output 8) (fasl-u32 output (pocket.sys::%bytes-length object))
       (fasl-copy-bytes output object))
      ((= kind 9)
       (fasl-byte output 9) (fasl-u32 output 4)
       (fasl-u32 output (fasl-id registry 4 object)))
      (t (pocket.sys::%error "PFAS writer: unsupported object at emission")))))
(defun fasl-write-objects (output registry)
  (let* ((objects (svref registry 1))
         (offset (fasl-section output 2 (buffer-length objects))) (index 0))
    (tagbody next
      (if (= index (buffer-length objects)) (go done) nil)
      (fasl-write-object output registry (buffer-ref objects index))
      (setq index (1+ index))
      (go next)
     done)
    (fasl-end-section output offset)))
(defun fasl-write-protos (output registry)
  (let* ((protos (svref registry 5))
         (offset (fasl-section output 3 (buffer-length protos))) (index 0))
    (tagbody next
      (if (= index (buffer-length protos)) (go done) nil)
      (let ((proto (buffer-ref protos index)))
        (fasl-u32 output (fasl-id registry 0 (pocket.sys::%proto-ref proto 0)))
        (fasl-u32 output (pocket.sys::%proto-ref proto 1))
        (fasl-u32 output (if (pocket.sys::%proto-ref proto 2) 1 0))
        (fasl-u32 output (pocket.sys::%proto-ref proto 3))
        (fasl-u32 output (pocket.sys::%proto-ref proto 4))
        (fasl-u32 output (pocket.sys::%proto-ref proto 5))
        (fasl-u32 output (pocket.sys::%proto-ref proto 6))
        (fasl-u32 output (fasl-id registry 0 (pocket.sys::%proto-ref proto 7)))
        (fasl-u32 output (fasl-id registry 0 (pocket.sys::%proto-ref proto 8))))
      (setq index (1+ index))
      (go next)
     done)
    (fasl-end-section output offset)))

;;; The entry point is bytecode too: ordinary calls run source initializers in
;;; order. The loader validates and returns this closure; it never runs Lisp.
(defun fasl-entry (protos)
  (let* ((pool (make-buffer)) (output (fasl-output)) (remaining protos))
    (buffer-push pool nil)
    (tagbody next
      (if (null remaining) (go done) nil)
      (fasl-byte output 15) (fasl-u32 output (buffer-push pool (car remaining)))
      (fasl-byte output 12) (fasl-u32 output 0) (fasl-byte output 8)
      (setq remaining (cdr remaining))
      (go next)
     done)
    (fasl-byte output 1) (fasl-u32 output 0) (fasl-byte output 14)
    (pocket.sys::%make-proto nil 0 nil 0 0 1 (pocket.sys::%fixnum-bits)
                            (fasl-finish output) (buffer-vector pool))))
(defun write-fasl (protos flags)
  (let* ((entry (fasl-entry protos)) (registry (fasl-registry))
         (output (fasl-output)))
    (fasl-object registry entry)
    (fasl-scan registry)
    (fasl-byte output 80) (fasl-byte output 70)
    (fasl-byte output 65) (fasl-byte output 83)
    (fasl-integer output 1 2)
    (fasl-integer output (+ flags (if (= (pocket.sys::%fixnum-bits) 31) 256 0)) 2)
    (fasl-u32 output 0) (fasl-u32 output 4)
    (fasl-write-symbols output registry)
    (fasl-write-objects output registry)
    (fasl-write-protos output registry)
    (let ((offset (fasl-section output 4 1)))
      (fasl-u32 output (fasl-id registry 4 entry))
      (fasl-end-section output offset))
    (fasl-patch-u32 output 8 (svref output 0))
    (fasl-finish output)))
