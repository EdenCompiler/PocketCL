(in-package :pocket.test)

(defpackage :pocket.test.package-source
  (:use :cl)
  (:nicknames "POCKET-PKG-ALIAS"))

(defpackage :pocket.test.package-consumer
  (:use :cl))

(deftest package-semantics
  (let* ((source (find-package "POCKET.TEST.PACKAGE-SOURCE"))
         (consumer (find-package "POCKET.TEST.PACKAGE-CONSUMER"))
         (source-name (intern "PACKAGE-PUBLIC-NAME" source))
         (case-symbol (intern "MiXeD-Case" source))
         (user-package (find-package "COMMON-LISP-USER")))
    (is (eq source (find-package "POCKET.TEST.PACKAGE-SOURCE")))
    (is (eq source (find-package "POCKET-PKG-ALIAS")))
    (is (eq *package* (find-package "POCKET.TEST")))
    (multiple-value-bind (found status)
        (find-symbol "PACKAGE-PUBLIC-NAME" source)
      (is (eq found source-name))
      (is (eq status :internal)))
    (is-equal "MiXeD-Case" (symbol-name case-symbol))
    (multiple-value-bind (found status) (find-symbol "MIXED-CASE" source)
      (is (and (null found) (null status))))
    (is (use-package "COMMON-LISP" consumer))
    (multiple-value-bind (found status) (find-symbol "CAR" consumer)
      (is (eq found (find-symbol "CAR" "COMMON-LISP")))
      (is (eq status :inherited)))
    (is (eq t (shadow "CAR" consumer)))
    (multiple-value-bind (found status) (find-symbol "CAR" consumer)
      (is (and (eq status :internal)
               (not (eq found (find-symbol "CAR" "COMMON-LISP"))))))
    (is (eq t (export source-name source)))
    (multiple-value-bind (found status)
        (find-symbol "PACKAGE-PUBLIC-NAME" source)
      (is (and (eq found source-name) (eq status :external))))
    (is (use-package source consumer))
    (multiple-value-bind (found status)
        (find-symbol "PACKAGE-PUBLIC-NAME" consumer)
      (is (eq found source-name))
      (is (eq status :inherited)))
    (let ((imported (intern "PACKAGE-IMPORTED-NAME" user-package)))
      (is (eq t (export imported user-package)))
      (is (eq t (import imported consumer)))
      (multiple-value-bind (found status)
          (find-symbol "PACKAGE-IMPORTED-NAME" consumer)
        (is (eq found imported))
        (is (eq status :internal))))
    (let ((symbol (intern "PACKAGE-VALUE-CELL" source)))
      (is (eq source (symbol-package symbol)))
      (is (= (set symbol 37) 37))
      (is (= (symbol-value symbol) 37))
      (is (boundp symbol)))))

(finish)
