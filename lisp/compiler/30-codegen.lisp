;;; Bytecode emission. Each routine either pushes one Lisp value or transfers
;;; control; the C verifier performs the final stack/control-flow proof.
(in-package :pocket-compiler)

(defconstant +op-const+ 1) (defconstant +op-global+ 2)
(defconstant +op-set-global+ 3) (defconstant +op-function+ 4)
(defconstant +op-local+ 5) (defconstant +op-set-local+ 6)
(defconstant +op-free+ 7) (defconstant +op-pop+ 8) (defconstant +op-dup+ 9)
(defconstant +op-jump+ 10) (defconstant +op-jump-nil+ 11)
(defconstant +op-call+ 12) (defconstant +op-tail-call+ 13)
(defconstant +op-return+ 14) (defconstant +op-closure+ 15)
(defconstant +op-box+ 16) (defconstant +op-unbox+ 17)
(defconstant +op-set-box+ 18) (defconstant +op-values+ 19)
(defconstant +op-mv-list+ 20) (defconstant +op-mv-restore+ 21)
(defconstant +op-bind-special+ 22) (defconstant +op-push-catch+ 23)
(defconstant +op-push-block+ 24) (defconstant +op-push-tagbody+ 25)
(defconstant +op-push-unwind+ 26) (defconstant +op-pop-dynamic+ 27)
(defconstant +op-throw+ 28) (defconstant +op-return-from+ 29)
(defconstant +op-go+ 30) (defconstant +op-add+ 31)
(defconstant +op-sub+ 32) (defconstant +op-lt+ 33)
(defconstant +op-num-eq+ 34) (defconstant +op-cons+ 35)
(defconstant +op-car+ 36) (defconstant +op-cdr+ 37)

;;; State vector: #(output constants context required rest name stack max dynamic).
(defconstant +cg-output+ 0) (defconstant +cg-constants+ 1)
(defconstant +cg-context+ 2) (defconstant +cg-required+ 3)
(defconstant +cg-rest+ 4) (defconstant +cg-name+ 5)
(defconstant +cg-stack+ 6) (defconstant +cg-max-stack+ 7)
(defconstant +cg-dynamic+ 8)
(defconstant +cg-analysis+ 9)

(defun make-codegen-state (context required rest name analysis)
  (vector (fasl-output) (make-buffer) context required rest name 0 0 0 analysis))
(defun cg-constant (state value)
  (if (= (pocket.sys::%object-kind value) -1)
      (fasl-check-target-fixnum value)
      nil)
  (buffer-push (svref state +cg-constants+) value))
(defun cg-byte (state value) (fasl-byte (svref state +cg-output+) value))
(defun cg-u32 (state value) (fasl-u32 (svref state +cg-output+) value))
(defun cg-op (state opcode) (cg-byte state opcode))
(defun cg-op-arg (state opcode argument)
  (cg-op state opcode) (cg-u32 state argument))
(defun cg-adjust-stack (state delta)
  (let ((depth (+ (svref state +cg-stack+) delta)))
    (if (< depth 0) (pocket.sys::%error "compiler stack accounting underflow") nil)
    (vset state +cg-stack+ depth)
    (if (> depth (svref state +cg-max-stack+))
        (vset state +cg-max-stack+ depth) nil)))
(defun cg-push-constant (state value)
  (cg-op-arg state +op-const+ (cg-constant state value))
  (cg-adjust-stack state 1))
(defun cg-emit-global (state opcode name)
  (cg-op-arg state opcode (cg-constant state name))
  (if (= opcode +op-set-global+) nil (cg-adjust-stack state 1)))
(defun cg-emit-binding-read (state binding)
  (multiple-value-bind (where slot)
      (context-resolve-binding (svref state +cg-context+) binding)
    (cg-op-arg state (if (eq where :local) +op-local+ +op-free+) slot)
    (cg-adjust-stack state 1)
    (if (svref binding +binding-boxed+)
        (cg-op state +op-unbox+) nil)))
(defun cg-emit-binding-cell (state binding)
  (multiple-value-bind (where slot)
      (context-resolve-binding (svref state +cg-context+) binding)
    (cg-op-arg state (if (eq where :local) +op-local+ +op-free+) slot)
    (cg-adjust-stack state 1)))
(defun cg-box-local-slot (state slot)
  (cg-op-arg state +op-local+ slot)
  (cg-adjust-stack state 1)
  (cg-op state +op-box+)
  (cg-op-arg state +op-set-local+ slot)
  (cg-op state +op-pop+)
  (cg-adjust-stack state -1))
(defun cg-emit-binding-write (state binding)
  (multiple-value-bind (where slot)
      (context-resolve-binding (svref state +cg-context+) binding)
    (if (svref binding +binding-boxed+)
        (progn (cg-emit-binding-cell state binding)
               ;; Reorder [value,box] to the SET_BOX contract [box,value].
               (cg-op state +op-set-box+))
        (progn (cg-op-arg state (if (eq where :local) +op-set-local+ +op-set-local+) slot)
               (cg-adjust-stack state 0)))))

(defun cg-sequence (state forms tailp)
  (if (null forms) (cg-push-constant state nil)
      (if (null (cdr forms)) (cg-form state (car forms) tailp)
          (if (cg-control-transfer-form-p (car forms))
              (cg-form state (car forms) nil)
              (progn (cg-form state (car forms) nil)
                     (cg-op state +op-pop+) (cg-adjust-stack state -1)
                     (cg-sequence state (cdr forms) tailp))))))

(defun cg-branch-placeholder (state opcode)
  (cg-op state opcode)
  (let ((offset (svref (svref state +cg-output+) 0)))
    (cg-u32 state 0)
    offset))
(defun cg-patch-branch (state operand-offset target-offset)
  (fasl-patch-u32 (svref state +cg-output+) operand-offset
                  (- target-offset (+ operand-offset 4))))
(defun cg-code-offset (state) (svref (svref state +cg-output+) 0))

(defun cg-compile-if (state form tailp)
  (let* ((test (cadr form)) (yes (caddr form))
         (no (if (consp (cdddr form)) (cadddr form) nil)))
    (cg-form state test nil)
    (cg-adjust-stack state -1)
    (let ((base (svref state +cg-stack+)))
      (let ((otherwise (cg-branch-placeholder state +op-jump-nil+)))
      (cg-form state yes tailp)
      (let ((end (cg-branch-placeholder state +op-jump+)))
        (cg-patch-branch state otherwise (cg-code-offset state))
        ;; A terminal yes arm has no result on its fallthrough edge. Restart
        ;; the else arm at the conditional's common stack height.
        (vset state +cg-stack+ base)
        (cg-form state no tailp)
        (cg-patch-branch state end (cg-code-offset state)))))))

(defun cg-variable (state symbol)
  (multiple-value-bind (binding found)
      (context-lookup (svref state +cg-context+) symbol :value)
    (if (and found (compiler-binding-p binding))
        (if (eq (svref binding +binding-kind+) :special)
            (cg-emit-global state +op-global+ symbol)
            (cg-emit-binding-read state binding))
        (cg-emit-global state +op-global+ symbol))))

(defun cg-function-value (state name)
  (multiple-value-bind (binding found)
      (context-lookup (svref state +cg-context+) name :function)
    (if (and found (compiler-binding-p binding))
        (cg-emit-binding-read state binding)
        (cg-emit-global state +op-function+ name))))

(defun cg-hot-call (state name args tailp)
  (let ((opcode (cond ((eq name '+) +op-add+) ((eq name '-) +op-sub+)
                      ((eq name '<) +op-lt+) ((eq name '=) +op-num-eq+)
                      ((eq name 'cons) +op-cons+)
                      ((eq name 'car) +op-car+) ((eq name 'cdr) +op-cdr+)
                      (t nil))))
    (multiple-value-bind (local-function found)
        (context-lookup (svref state +cg-context+) name :function)
      (if (and found (compiler-binding-p local-function)) (setq opcode nil) nil))
    (if (null opcode) nil
        (or (cg-folded-hot-call state name args tailp)
            (cg-emit-hot-opcode state name opcode args)))))

(defun cg-emit-hot-opcode (state name opcode args)
  (let ((arity (if (or (= opcode +op-car+) (= opcode +op-cdr+)) 1 2)))
    (if (not (= (length args) arity)) nil
        (progn
          (cg-form state (car args) nil)
          (if (= arity 2) (cg-form state (cadr args) nil) nil)
          (if (= arity 2) (cg-adjust-stack state -1) nil)
          (cg-op-arg state opcode (cg-constant state name))
          t))))

;;; Read a literal fixnum without evaluating source code. Quoted integers are
;;; constants too; every candidate is checked against the bytecode target.
(defun cg-literal-target-fixnum (form)
  (let ((value (if (and (consp form) (eq (car form) 'quote)
                        (consp (cdr form)) (null (cddr form)))
                   (cadr form) form)))
    (if (and (integerp value)
             (= (pocket.sys::%object-kind value) -1)
             (fasl-target-fixnum-p value (pocket.sys::%fixnum-bits)))
        (values value t)
        (values nil nil))))

(defun cg-folded-hot-value (name left right)
  (let* ((bits (pocket.sys::%fixnum-bits))
         (minimum (ash -1 (1- bits)))
         (maximum (- -1 minimum)))
    (cond ((eq name '+)
           ;; Check before adding so the host integer operation cannot overflow.
           (if (if (> right 0) (<= left (- maximum right))
                   (if (< right 0) (>= left (- minimum right)) t))
               (values (+ left right) t)
               (values nil nil)))
          ((eq name '-)
           (if (if (< right 0) (<= left (+ maximum right))
                   (if (> right 0) (>= left (+ minimum right)) t))
               (values (- left right) t)
               (values nil nil)))
          ((eq name '<) (values (< left right) t))
          ((eq name '=) (values (= left right) t))
          (t (values nil nil)))))

(defun cg-ordinary-call (state operator arguments tailp)
  (if (symbolp operator)
      (cg-function-value state operator)
      (cg-form state operator nil))
  (let ((remaining arguments))
    (tagbody arguments-loop
      (if (null remaining) (go arguments-done) nil)
      (cg-form state (car remaining) nil)
      (setq remaining (cdr remaining))
      (go arguments-loop)
     arguments-done))
  (if (and tailp (= (svref state +cg-dynamic+) 0))
      (cg-op-arg state +op-tail-call+ (length arguments))
      (progn (cg-op-arg state +op-call+ (length arguments))
             (cg-adjust-stack state (- (length arguments))))))

(defun cg-emit-folded-hot-call (state name args tailp folded)
  ;; The branch test and both result paths meet at the caller's entry depth + 1.
  (let ((base (svref state +cg-stack+)))
    ;; Keep global function redefinition observable at runtime.
    (cg-function-value state 'pocket.sys::%builtin-function-p)
    (cg-push-constant state name)
    (cg-op-arg state +op-call+ 1)
    (cg-adjust-stack state -1)
    (let ((otherwise (cg-branch-placeholder state +op-jump-nil+)))
      (cg-adjust-stack state -1)
      (cg-push-constant state folded)
      (let ((end (cg-branch-placeholder state +op-jump+)))
        (cg-patch-branch state otherwise (cg-code-offset state))
        (vset state +cg-stack+ base)
        (cg-ordinary-call state name args tailp)
        (cg-patch-branch state end (cg-code-offset state))
        ;; The folded branch supplies the join value even after a fallback
        ;; tail-call, whose branch has no fallthrough value in the verifier.
        (vset state +cg-stack+ (1+ base)))
      t)))

(defun cg-folded-hot-call (state name args tailp)
  (if (or (not (member name (list '+ '- '< '=)))
          (not (= (length args) 2)))
      nil
      (multiple-value-bind (local-function found)
          (context-lookup (svref state +cg-context+) name :function)
        (if (and found (compiler-binding-p local-function)) nil
            (multiple-value-bind (left left-found)
                (cg-literal-target-fixnum (car args))
              (if (not left-found) nil
                  (multiple-value-bind (right right-found)
                      (cg-literal-target-fixnum (cadr args))
                    (if (not right-found) nil
                        (multiple-value-bind (folded foldable)
                            (cg-folded-hot-value name left right)
                          (if foldable
                              (cg-emit-folded-hot-call state name args tailp folded)
                              nil))))))))))

(defun cg-call (state operator arguments tailp)
  (if (and (symbolp operator) (cg-hot-call state operator arguments tailp)) nil
      (cg-ordinary-call state operator arguments tailp)))

(defun cg-setq (state pairs)
  (if (null pairs) (cg-push-constant state nil)
      (let ((name (car pairs)) (expression (cadr pairs)))
        (multiple-value-bind (binding found)
            (context-lookup (svref state +cg-context+) name :value)
          (if (and found (compiler-binding-p binding)
                   (not (eq (svref binding +binding-kind+) :special)))
              (progn
                (context-mark-assigned binding)
                (if (svref binding +binding-boxed+)
                    (progn (cg-emit-binding-cell state binding)
                           (cg-form state expression nil)
                           (cg-op state +op-set-box+)
                           (cg-adjust-stack state -1))
                    (progn
                      (cg-form state expression nil)
                      (multiple-value-bind (where slot)
                          (context-resolve-binding (svref state +cg-context+) binding)
                        (cg-op-arg state (if (eq where :local) +op-set-local+ +op-set-local+) slot)))))
              (progn (cg-form state expression nil)
                     (cg-emit-global state +op-set-global+ name)))
        (if (null (cddr pairs)) nil
            (progn (cg-op state +op-pop+) (cg-adjust-stack state -1)
                   (cg-setq state (cddr pairs))))))))

(defun cg-form-core (state form tailp)
  (cond
    ((symbolp form) (cg-variable state form))
    ((not (consp form)) (cg-push-constant state form))
    ((eq (car form) 'quote) (cg-push-constant state (cadr form)))
    ((eq (car form) 'if) (cg-compile-if state form tailp))
    ((eq (car form) 'progn) (cg-sequence state (cdr form) tailp))
    ((eq (car form) 'setq) (cg-setq state (cdr form)))
    ((eq (car form) 'function)
     (let ((designator (cadr form)))
       (if (and (consp designator) (eq (car designator) 'lambda))
           ;; Let cg-form resolve the analysis-time normalized lambda. This
           ;; matters for rich lists such as &OPTIONAL parameter lists.
           (cg-form state designator nil)
           (if (symbolp designator) (cg-function-value state designator)
               (pocket.sys::%error "FUNCTION requires a name or lambda")))))
    ((eq (car form) 'lambda)
     (cg-compile-lambda state form nil))
    ((eq (car form) 'values)
     (let ((arguments (cdr form)))
       (let ((remaining arguments))
         (tagbody value-arguments
           (if (null remaining) (go values-done) nil)
           (cg-form state (car remaining) nil)
           (setq remaining (cdr remaining))
           (go value-arguments)
          values-done))
       (cg-op-arg state +op-values+ (length arguments))
       (cg-adjust-stack state (if (null arguments) 1 (- 1 (length arguments))))))
    ((eq (car form) 'multiple-value-list)
     (cg-form state (cadr form) nil)
     (cg-op state +op-mv-list+))
    ((eq (car form) 'multiple-value-call)
     (cg-multiple-value-call state form tailp))
    ((eq (car form) 'multiple-value-prog1)
     (cg-multiple-value-prog1 state form tailp))
    ((eq (car form) 'let) (cg-let state form nil tailp))
    ((eq (car form) 'let*) (cg-let state form t tailp))
    ((eq (car form) 'flet) (cg-local-functions state form tailp))
    ((eq (car form) 'labels) (cg-local-functions state form tailp))
    ((eq (car form) 'block) (cg-block state form tailp))
    ((eq (car form) 'return-from) (cg-return-from state (cadr form) (caddr form)))
    ((eq (car form) 'catch) (cg-catch state (cadr form) (cddr form) tailp))
    ((eq (car form) 'throw) (cg-throw state (cadr form) (caddr form)))
    ((eq (car form) 'unwind-protect) (cg-unwind-protect state form))
    ((eq (car form) 'tagbody) (cg-tagbody state form))
    ((eq (car form) 'go) (cg-go state form))
    ((eq (car form) 'the) (cg-form state (caddr form) tailp))
    ((eq (car form) 'locally)
     (let ((outer (svref state +cg-context+)))
       (vset state +cg-context+
             (analysis-context-for (svref state +cg-analysis+) form outer))
       (cg-sequence state (body-expressions (cdr form)) tailp)
       (vset state +cg-context+ outer)))
    ((eq (car form) 'macrolet)
     (let ((outer (svref state +cg-context+)))
       (vset state +cg-context+
             (analysis-context-for (svref state +cg-analysis+) form outer))
       (cg-sequence state (cddr form) tailp)
       (vset state +cg-context+ outer)))
    ((eq (car form) 'symbol-macrolet)
     (let ((outer (svref state +cg-context+)))
       (vset state +cg-context+
             (analysis-context-for (svref state +cg-analysis+) form outer))
       (cg-sequence state (cddr form) tailp)
       (vset state +cg-context+ outer)))
    ((eq (car form) 'eval-when)
     (if (member :execute (cadr form))
         (cg-sequence state (body-expressions (cddr form)) tailp)
         (cg-push-constant state nil)))
    (t (cg-call state (car form) (cdr form) tailp))))

(defun cg-form (state form tailp)
  (cg-form-core state
                (analysis-expanded-form (svref state +cg-analysis+) form
                                        (svref state +cg-context+))
                tailp))

;;; MULTIPLE-VALUE-CALL harvests each argument's values immediately. Keeping
;;; those lists in analyzed frame slots prevents a later function call from
;;; overwriting values that have not yet been collected.
(defun cg-store-temp (state binding)
  (cg-op-arg state +op-set-local+ (svref binding +binding-slot+))
  (cg-op state +op-pop+)
  (cg-adjust-stack state -1))
(defun cg-load-temp (state binding)
  (cg-op-arg state +op-local+ (svref binding +binding-slot+))
  (cg-adjust-stack state 1))
(defun cg-multiple-value-call (state form tailp)
  (let* ((database (svref state +cg-analysis+))
         (data (multiple-value-bind (value found)
                   (analysis-table-get database +analysis-mvcalls+
                                       (svref state +cg-context+) form)
                 (if found value (vector nil (vector)))))
         (function-temp (svref data 0)) (argument-temps (svref data 1))
         (outer (svref state +cg-context+)) (index 0))
    (cg-form state (cadr form) nil)
    (cg-store-temp state function-temp)
    (tagbody harvest
      (if (= index (length argument-temps)) (go harvested) nil)
      (cg-form state (nth (+ index 2) form) nil)
      (cg-op state +op-mv-list+)
      (cg-store-temp state (svref argument-temps index))
      (setq index (1+ index))
      (go harvest)
     harvested)
    (cg-function-value state 'apply)
    (cg-load-temp state function-temp)
    (cg-function-value state 'append)
    (setq index 0)
    (tagbody append-arguments
      (if (= index (length argument-temps)) (go appended) nil)
      (cg-load-temp state (svref argument-temps index))
      (setq index (1+ index))
      (go append-arguments)
     appended)
    (cg-op-arg state +op-call+ (length argument-temps))
    (cg-adjust-stack state (- (length argument-temps)))
    (cg-op-arg state +op-call+ 2)
    (cg-adjust-stack state -2)
    (vset state +cg-context+ outer)
    (if tailp
        ;; The final APPLY is already on the stack as a normal CALL. It can
        ;; become a tail call only by moving its operator and arguments, so
        ;; retain the straightforward verified call sequence here.
        nil nil)))
(defun cg-multiple-value-prog1 (state form tailp)
  (let* ((database (svref state +cg-analysis+))
         (binding (multiple-value-bind (value found)
                     (analysis-table-get database +analysis-mvprog1+
                                         (svref state +cg-context+) form)
                   (if found value nil)))
         (outer (svref state +cg-context+)))
    (cg-form state (cadr form) nil)
    (cg-op state +op-mv-list+)
    (cg-store-temp state binding)
    ;; Cleanup values are discarded, while the saved value list is restored
    ;; below. Leaving the cleanup primary on the operand stack makes this
    ;; form appear to work alone but shifts the operator slot of an enclosing
    ;; call when MULTIPLE-VALUE-PROG1 is used as an argument.
    (if (cddr form)
        (progn (cg-sequence state (cddr form) nil)
               (cg-op state +op-pop+)
               (cg-adjust-stack state -1))
        nil)
    (cg-load-temp state binding)
    (cg-op state +op-mv-restore+)
    (vset state +cg-context+ outer)
    (if tailp nil nil)))

;;; Function constructors are defined in the following blocks; keeping them
;;; separate makes scope creation and bytecode emission easy to audit.
(defun cg-compile-lambda (state form name)
  (cg-compile-function state form name))

(defun cg-compile-function (parent-state form name)
  (let* ((database (svref parent-state +cg-analysis+))
         (parent-context (svref parent-state +cg-context+))
         (context (analysis-context-for database form parent-context))
         (parameters-data (multiple-value-bind (value found)
                              (analysis-table-get database +analysis-lambdas+
                                                  parent-context form)
                            (if found value (vector 0 nil nil))))
         (required (svref parameters-data 0))
         (restp (svref parameters-data 1))
         (parameter-count (+ required (if restp 1 0)))
         (body (cddr form))
         (state (make-codegen-state context required restp name database))
         (expressions (body-expressions body)))
      (let ((slot 0) (locals (svref context +context-locals+)))
        (tagbody box-parameters
          (if (= slot parameter-count) (go parameters-boxed) nil)
          (let ((binding (buffer-ref locals slot)))
            (cond ((eq (svref binding +binding-kind+) :special)
                   (cg-op-arg state +op-local+ slot)
                   (cg-adjust-stack state 1)
                   (cg-op-arg state +op-bind-special+
                              (cg-constant state (svref binding +binding-name+)))
                   (cg-adjust-stack state -1)
                   (vset state +cg-dynamic+ (1+ (svref state +cg-dynamic+))))
                  ((svref binding +binding-boxed+)
                   (cg-box-local-slot state slot))
                  (t nil)))
          (setq slot (1+ slot)) (go box-parameters)
         parameters-boxed))
      ;; Assigned captures and LABELS cells are boxed after the completed
      ;; nested-function analysis marks their binding vectors.
      (cg-sequence state expressions t)
      (cg-op state +op-return+)
      (let* ((locals (context-local-count context))
             (free (context-free-count context))
             (bits (pocket.sys::%fixnum-bits))
             (code (fasl-finish (svref state +cg-output+)))
             (pool (buffer-vector (svref state +cg-constants+)))
             (proto (pocket.sys::%make-proto name (svref state +cg-required+)
                     (svref state +cg-rest+) locals free
                     (if (> (svref state +cg-max-stack+) 0)
                         (svref state +cg-max-stack+) 1)
                     bits code pool)))
        ;; CLOSURE consumes captures in the child's deterministic free order.
        (let ((free-index 0))
          (tagbody captures
            (if (= free-index free) (go captures-done) nil)
            (let ((binding (buffer-ref (svref context +context-freevars+) free-index)))
              (cg-emit-capture parent-state binding))
            (setq free-index (1+ free-index))
            (go captures)
           captures-done))
        (cg-op-arg parent-state +op-closure+ (cg-constant parent-state proto))
        (cg-adjust-stack parent-state (- free))
        (cg-adjust-stack parent-state 1))))

(defun cg-emit-capture (state binding)
  (multiple-value-bind (where slot)
      (context-resolve-binding (svref state +cg-context+) binding)
    (cg-op-arg state (if (eq where :local) +op-local+ +op-free+) slot)
    (cg-adjust-stack state 1)))

(defun cg-let (state form sequential tailp)
  (let* ((database (svref state +cg-analysis+))
         (outer (svref state +cg-context+))
         (context (analysis-context-for database form outer))
         (entries (multiple-value-bind (value found)
                     (analysis-table-get database +analysis-lets+ outer form)
                   (if found value (vector))))
         (index 0) (dynamic-count 0))
    (if sequential
        (tagbody sequential-init
          (if (= index (length entries)) (go sequential-done) nil)
          (let* ((entry (svref entries index)) (initializer (svref entry 0))
                 (init-context (svref entry 1)) (binding (svref entry 2))
                 (slot (svref binding +binding-slot+)))
            (vset state +cg-context+ init-context)
            (cg-form state initializer nil)
            (if (eq (svref binding +binding-kind+) :special)
                (progn
                  (cg-op-arg state +op-bind-special+
                             (cg-constant state (svref binding +binding-name+)))
                  (cg-adjust-stack state -1)
                  (vset state +cg-dynamic+ (1+ (svref state +cg-dynamic+)))
                  (setq dynamic-count (1+ dynamic-count)))
                (progn
                  (cg-op-arg state +op-set-local+ slot)
                  (cg-op state +op-pop+) (cg-adjust-stack state -1)
                  (if (svref binding +binding-boxed+)
                      (cg-box-local-slot state slot) nil))))
          (setq index (1+ index)) (go sequential-init)
         sequential-done)
        (progn
          ;; LET evaluates every initializer in the outer environment before
          ;; installing any parallel lexical or dynamic binding.
          (tagbody evaluate-inits
            (if (= index (length entries)) (go inits-done) nil)
            (let* ((entry (svref entries index))
                   (initializer (svref entry 0))
                   (init-context (svref entry 1))
                   (temporary (svref entry 3)))
              (vset state +cg-context+ init-context)
              (cg-form state initializer nil)
              (cg-op-arg state +op-set-local+ (svref temporary +binding-slot+))
              (cg-op state +op-pop+) (cg-adjust-stack state -1))
            (setq index (1+ index)) (go evaluate-inits)
           inits-done)
          (setq index 0)
          (tagbody install-bindings
            (if (= index (length entries)) (go bindings-done) nil)
            (let* ((entry (svref entries index)) (binding (svref entry 2))
                   (temporary (svref entry 3)) (slot (svref binding +binding-slot+)))
              (cg-op-arg state +op-local+ (svref temporary +binding-slot+))
              (cg-adjust-stack state 1)
              (if (eq (svref binding +binding-kind+) :special)
                  (progn
                    (cg-op-arg state +op-bind-special+
                               (cg-constant state (svref binding +binding-name+)))
                    (cg-adjust-stack state -1)
                    (vset state +cg-dynamic+ (1+ (svref state +cg-dynamic+)))
                    (setq dynamic-count (1+ dynamic-count)))
                  (progn
                    (cg-op-arg state +op-set-local+ slot)
                    (cg-op state +op-pop+) (cg-adjust-stack state -1)
                    (if (svref binding +binding-boxed+)
                        (cg-box-local-slot state slot) nil))))
            (setq index (1+ index)) (go install-bindings)
           bindings-done)))
    (vset state +cg-context+ context)
    (cg-sequence state (body-expressions (cddr form)) tailp)
    (if (> dynamic-count 0)
        (progn (cg-op-arg state +op-pop-dynamic+ dynamic-count)
               (vset state +cg-dynamic+ (- (svref state +cg-dynamic+) dynamic-count)))
        nil)
    (vset state +cg-context+ outer)))

(defun cg-local-functions (state form tailp)
  (let* ((database (svref state +cg-analysis+))
         (outer (svref state +cg-context+))
         (data (multiple-value-bind (value found)
                   (analysis-table-get database +analysis-funs+ outer form)
                 (if found value (vector nil (vector)))))
         (labels-p (svref data 0)) (functions (svref data 1))
         (index 0))
    (vset state +cg-context+ (analysis-context-for database form outer))
    ;; Create every LABELS cell before any closure captures the recursive
    ;; group. NIL is a safe placeholder if an initializer is inspected early.
    (if labels-p
        (tagbody initialize-cells
          (if (= index (length functions)) (go cells-ready) nil)
          (let* ((entry (svref functions index))
                 (binding (svref entry 2))
                 (slot (svref binding +binding-slot+)))
            (cg-push-constant state nil)
            (cg-op state +op-box+)
            (cg-op-arg state +op-set-local+ slot)
            (cg-op state +op-pop+) (cg-adjust-stack state -1))
          (setq index (1+ index)) (go initialize-cells)
         cells-ready)
        nil)
    (setq index 0)
    (tagbody install-functions
      (if (= index (length functions)) (go functions-installed) nil)
      (let* ((entry (svref functions index)) (name (svref entry 0))
             (lambda-form (svref entry 1)) (binding (svref entry 2))
             (slot (svref binding +binding-slot+))
             (function-context (svref state +cg-context+)))
        (if labels-p (cg-emit-binding-cell state binding) nil)
        ;; FLET function bodies are analyzed outside the local function
        ;; contour; LABELS bodies are analyzed inside it.
        (vset state +cg-context+ (if labels-p function-context outer))
        (cg-compile-lambda state lambda-form name)
        (vset state +cg-context+ function-context)
        (if labels-p
            (progn
              ;; The recursive cell is already on the stack below the closure.
              (cg-op state +op-set-box+)
              (cg-op state +op-pop+) (cg-adjust-stack state -1))
            (progn
              (cg-op-arg state +op-set-local+ slot)
              (cg-op state +op-pop+) (cg-adjust-stack state -1))))
      (setq index (1+ index)) (go install-functions)
     functions-installed)
    (cg-sequence state (cddr form) tailp)
    (vset state +cg-context+ outer)))

;;; Dynamic-control and assignment helpers are kept as named entry points so
;;; the subsequent analysis pass can add lexical token maps without changing
;;; ordinary expression emission.
(defun cg-block (state form tailp)
  (let* ((database (svref state +cg-analysis+))
         (outer (svref state +cg-context+))
         (data (multiple-value-bind (value found)
                   (analysis-table-get database +analysis-blocks+ outer form)
                 (if found value (vector nil nil nil))))
         (body (svref data 0)) (active (svref data 1))
         (binding (svref data 2)))
    ;; Even an elided runtime block has a lexical contour. Expansion records
    ;; belong to that contour, and nested macros must see it during emission.
    (vset state +cg-context+ (analysis-context-for database form outer))
    (if (not active) (cg-sequence state body tailp)
        (let ((end-branch 0))
          (setq end-branch (cg-branch-placeholder state +op-push-block+))
          (cg-adjust-stack state 1)
          (cg-op-arg state +op-set-local+ (svref binding +binding-slot+))
          (cg-op state +op-pop+) (cg-adjust-stack state -1)
          (vset state +cg-dynamic+ (1+ (svref state +cg-dynamic+)))
          (cg-sequence state body nil)
          (cg-op-arg state +op-pop-dynamic+ 1)
          (vset state +cg-dynamic+ (1- (svref state +cg-dynamic+)))
          (cg-patch-branch state end-branch (cg-code-offset state))))
    (vset state +cg-context+ outer)))
(defun cg-return-from (state name value)
  (multiple-value-bind (binding found)
      (context-lookup (svref state +cg-context+) name :block)
    (if (not found) (pocket.sys::%error "RETURN-FROM has no lexical BLOCK") nil)
    (cg-emit-binding-cell state binding)
    (cg-form state value nil)
    (cg-op state +op-return-from+)
    ;; The transfer edge supplies the primary result at the block target.
    (cg-adjust-stack state -1)))
(defun cg-catch (state tag body tailp)
  (let ((base (svref state +cg-stack+)))
    (cg-form state tag nil)
    (let ((handler (cg-branch-placeholder state +op-push-catch+)))
      (cg-adjust-stack state -1)
      (vset state +cg-dynamic+ (1+ (svref state +cg-dynamic+)))
      (cg-sequence state body nil)
      (cg-op-arg state +op-pop-dynamic+ 1)
      (vset state +cg-dynamic+ (1- (svref state +cg-dynamic+)))
      (cg-patch-branch state handler (cg-code-offset state))
      ;; A THROW body is a terminal edge in ordinary control flow, but the
      ;; catch handler reaches the same target with the thrown primary value.
      ;; Keep the compiler's linear stack model at that verified join depth.
      (vset state +cg-stack+ (1+ base))
      (if tailp nil nil))))
(defun cg-throw (state tag value)
  (cg-form state tag nil)
  (cg-form state value nil)
  (cg-op state +op-throw+)
  (cg-adjust-stack state -2))
(defun cg-unwind-protect (state form)
  (let* ((database (svref state +cg-analysis+))
         (lambda-form (multiple-value-bind (value found)
                          (analysis-table-get database +analysis-unwinds+
                                              (svref state +cg-context+) form)
                        (if found value nil))))
    (if lambda-form nil (pocket.sys::%error "UNWIND-PROTECT analysis record missing"))
    (cg-compile-lambda state lambda-form nil)
    (cg-op state +op-push-unwind+)
    (cg-adjust-stack state -1)
    (vset state +cg-dynamic+ (1+ (svref state +cg-dynamic+)))
    (cg-form state (cadr form) nil)
    (cg-op-arg state +op-pop-dynamic+ 1)
    (vset state +cg-dynamic+ (1- (svref state +cg-dynamic+)))))
(defun cg-tag-label-index (tags name)
  (let ((index 0))
    (tagbody search
      (if (= index (length tags))
          (pocket.sys::%error "GO tag disappeared during code generation") nil)
      (if (eq (svref (svref tags index) 0) name) (go found) nil)
      (setq index (1+ index)) (go search)
     found)
    (svref (svref tags index) 1)))

(defun cg-tagbody (state form)
  (let* ((database (svref state +cg-analysis+))
         (data (multiple-value-bind (value found)
                   (analysis-table-get database +analysis-tagbodies+
                                       (svref state +cg-context+) form)
                 (if found value (vector nil nil nil (vector)))))
         (forms (svref data 0)) (context (svref data 1))
         (token (svref data 2)) (tags (svref data 3))
         (table (pocket.sys::%make-simple-vector (length tags) nil))
         (outer (svref state +cg-context+)) (items forms))
    (cg-op-arg state +op-push-tagbody+ (cg-constant state table))
    (cg-adjust-stack state 1)
    (cg-op-arg state +op-set-local+ (svref token +binding-slot+))
    (cg-op state +op-pop+) (cg-adjust-stack state -1)
    (vset state +cg-dynamic+ (1+ (svref state +cg-dynamic+)))
    (vset state +cg-context+ context)
    (tagbody emit-items
      (if (null items) (go items-done) nil)
      (if (consp (car items))
          (if (cg-control-transfer-form-p (car items))
              (cg-form state (car items) nil)
              (progn (cg-form state (car items) nil)
                     (cg-op state +op-pop+) (cg-adjust-stack state -1)))
          (vset table (cg-tag-label-index tags (car items)) (cg-code-offset state)))
      (setq items (cdr items)) (go emit-items)
     items-done)
    (cg-push-constant state nil)
    (cg-op-arg state +op-pop-dynamic+ 1)
    (vset state +cg-dynamic+ (1- (svref state +cg-dynamic+)))
    (vset state +cg-context+ outer)))

(defun cg-go (state form)
  (let ((name (cadr form)))
    (multiple-value-bind (tag found)
        (environment-lookup (svref (svref state +cg-context+)
                                   +context-environment+) :tag name)
      (if (and found (simple-vector-p tag) (eq (svref tag 0) :tag))
          (progn
            (cg-emit-binding-cell state (svref tag 1))
            (cg-op-arg state +op-go+ (svref tag 2))
            (cg-adjust-stack state -1))
          (pocket.sys::%error "GO has no lexical TAGBODY tag")))))

(defun cg-control-transfer-form-p (form)
  (and (consp form)
       (or (eq (car form) 'go) (eq (car form) 'throw)
           (eq (car form) 'return-from))))

(defun compile-form (form)
  (let* ((environment (make-compiler-environment nil))
         (context (make-compile-context nil environment nil))
         (analysis (make-analysis-database context)))
    (analysis-form analysis form context nil)
    (analysis-finalize-frame context)
    (let ((state (make-codegen-state context 0 nil nil analysis)))
      (cg-form state form t)
      (cg-op state +op-return+)
      (pocket.sys::%make-proto nil 0 nil (context-local-count context) 0
        (if (> (svref state +cg-max-stack+) 0)
            (svref state +cg-max-stack+) 1)
        (pocket.sys::%fixnum-bits)
        (fasl-finish (svref state +cg-output+))
        (buffer-vector (svref state +cg-constants+))))))
