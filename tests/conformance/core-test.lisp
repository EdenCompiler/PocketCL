  (is-equal nil (multiple-value-list (values)))
  (is-equal '(9) (multiple-value-list (progn (values 1 2) 9)))
  (is-equal '(3 1) (multiple-value-list (floor 10 3)))
  (is-equal '(-4 2) (multiple-value-list (floor -10 3)))
  (is-equal '(-3 -1) (multiple-value-list (truncate -10 3)))
  (is-equal '(4 -2) (multiple-value-list (ceiling 10 3)))
  (is-equal '(2 1) (multiple-value-list (round 5 2)))
  (is-equal '(4 -1) (multiple-value-list (round 7 2)))
  (is-equal '(1 2 3 4) (multiple-value-call #'list (values 1 2) (values) (values 3 4)))
  (let ((receiver #'list))
    (is-equal '(1 2) (multiple-value-call receiver (values 1 2))))
  (is-equal '(1 2) (multiple-value-list (multiple-value-prog1 (values 1 2) (values 9 8))))
  (is-equal '(1 2) (multiple-value-list (catch 'done (throw 'done (values 1 2)))))
  (is-equal '(3 4) (multiple-value-list (block done (return-from done (values 3 4)))))
  (multiple-value-bind (a b c) (values 1 2) (is (= a 1)) (is (= b 2)) (is (null c)))
  (is (= (nth-value 1 (values 5 6 7)) 6))
  (is (null (nth-value 3 (values 5))))
  (is-equal '(8 9) (multiple-value-list (values-list '(8 9))))
  (let ((a 0) (b 0))
    (multiple-value-setq (a b) (values 5 6 7))
    (is (= a 5)) (is (= b 6))))

(defmacro test-add (x &optional (y 2)) (list '+ x y))
(defmacro test-structure ((a &optional (b 3)) &body body)
  (list 'progn (list '+ a b) (cons 'progn body)))
(defmacro test-key (x &key (y 2 supplied))
  (if supplied (list '+ x y) (list '+ x 2)))
(defmacro test-whole (&whole whole x &environment environment)
  (declare (ignore environment))
  (list 'quote (list (car whole) x)))
(defmacro nested-builder (x) ``(a ,,x))
(defmacro test-function-shadow () 1)
(defmacro test-macro-exit () (return-from test-macro-exit 17))
(defmacro test-return-done () '(return-from macro-done 21))
(deftest macro-syntax
  (flet ((test-function-shadow () 2)) (is (= (test-function-shadow) 2)))
  (is (= (test-macro-exit) 17))
  (is (= (macrolet ((local-exit () (return-from local-exit 18))) (local-exit)) 18))
  ;; Unused-block elision must remain conservative across macro expansion
  ;; and a closure that can capture the lexical exit.
  (is (= (block macro-done (test-return-done)) 21))
  (is (= (block macro-done
           (flet ((invoke () (test-return-done))) (invoke))) 21))
  (is (= (test-add 3) 5)) (is (= (test-add 3 4) 7))
  (is (= (test-structure (1) 3 4) 4))
  (is (= (test-key 3) 5)) (is (= (test-key 3 :y 7) 10))
  (is-equal '(test-whole 8) (test-whole 8))
  (is (= (macrolet ((local (x) (list '+ x 1))) (local 4)) 5))
  (is (= (macrolet ((local (x &optional (y 3)) (list '+ x y))) (local 4)) 7))
  (is (= (macrolet ((inner (x) (list '+ x 4)))
           (macrolet ((outer (x &environment env) (macroexpand (list 'inner x) env)))
             (outer 2))) 6))
  (is (= (symbol-macrolet ((x (+ 2 3))) x) 5))
  (is (= (symbol-macrolet ((x 7)) (let ((x 3)) x)) 3))
  (is (= (symbol-macrolet ((x 7)) (let ((x 3)) (setq x 4) x)) 4))
  (let ((x 1)) (symbol-macrolet ((alias x)) (setq alias 7)) (is (= x 7)))
  (let ((x 1)) (symbol-macrolet ((x 7))) (is (= x 1)))
  (is-equal '(1 2 3) (destructuring-bind (a (b &optional (c 3))) '(1 (2)) (list a b c)))
  (is-equal '(1 2 3) `(1 ,(+ 1 1) ,@'(3)))
  (is-equal '(a b . c) `(a ,@'(b) . c))
  (is-equal '(a 3) (nested-builder 3))
  (let ((a (gensym)) (b (gensym)))
    (is (not (eq a b))) (is (null (symbol-package a))) (is (not (equal (symbol-name a) (symbol-name b))))))

