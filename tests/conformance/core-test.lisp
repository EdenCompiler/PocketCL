;;; Distinct values exercise the binding/lambda transformations rather than
;;; merely repeating an assertion. These include supplied defaults, explicit
;;; NIL, keyword reordering, and lexical capture at each value.
(defun binding-properties (n)
  (if (= n 0) nil
      (progn
        (is (= ((lambda (x &optional (y (1+ x))) y) n) (1+ n)))
        (is (= ((lambda (&key (x 0)) x) :x n) n))
        (is (= (funcall (let ((captured n)) (lambda () captured))) n))
        (is-equal (list n (1+ n)) (multiple-value-list (values n (1+ n))))
        (binding-properties (1- n)))))
(binding-properties 20)

(defun tail-million (n total)
  (if (= n 0) total (tail-million (1- n) (1+ total))))
(deftest proper-tail-calls
  (is (= (tail-million 1000000 0) 1000000)))

